---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_EMAIL } from '../consts';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Về Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			.hero-section {
				text-align: center;
				margin-bottom: 3rem;
				padding: 2rem;
				background: linear-gradient(135deg, rgba(var(--accent-light), 0.1) 0%, rgba(var(--accent), 0.05) 100%);
				border-radius: 12px;
			}
			.hero-icon {
				font-size: 4rem;
				margin-bottom: 1rem;
			}
			.about-section {
				margin-bottom: 3rem;
				line-height: 1.8;
			}
			.about-section h2 {
				color: var(--accent);
				margin-bottom: 1rem;
				font-size: 1.8rem;
			}
			.about-section p {
				margin-bottom: 1rem;
				color: var(--gray-dark);
			}
			.topics-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.5rem;
				margin-top: 1.5rem;
			}
			.topic-card {
				background: var(--bg-secondary, #f5f5f5);
				padding: 1.5rem;
				border-radius: 8px;
				border-left: 4px solid var(--accent);
			}
			.topic-card h3 {
				color: var(--accent);
				margin-bottom: 0.8rem;
				font-size: 1.2rem;
			}
			.topic-card p {
				font-size: 0.95rem;
				color: var(--gray);
				margin: 0;
			}
			.audience-list {
				list-style: none;
				padding: 0;
				margin-top: 1rem;
			}
			.audience-list li {
				padding: 0.8rem 0;
				border-bottom: 1px solid rgba(var(--accent), 0.1);
			}
			.audience-list li:last-child {
				border-bottom: none;
			}
			.audience-list li:before {
				content: "✓ ";
				color: var(--accent);
				font-weight: bold;
				margin-right: 0.5rem;
			}
			.cta-box {
				background: linear-gradient(135deg, rgba(var(--accent), 0.1) 0%, rgba(var(--accent-light), 0.05) 100%);
				padding: 2rem;
				border-radius: 12px;
				text-align: center;
				margin-top: 2rem;
			}
			.cta-box a {
				display: inline-block;
				background: var(--accent);
				color: white;
				padding: 0.8rem 2rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: bold;
				margin-top: 1rem;
				transition: transform 0.2s;
			}
			.cta-box a:hover {
				transform: translateY(-2px);
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-container">
			<div class="hero-section">
				<div class="hero-icon">🤖</div>
				<h1>Về AI Knowledge Hub</h1>
				<p style="font-size: 1.2rem; color: var(--gray); margin-top: 1rem;">
					Hệ thống kiến thức AI từ cơ bản đến chuyên sâu
				</p>
			</div>

			<div class="about-section">
				<h2>Tại sao có blog này?</h2>
				<p>
					<strong>AI Knowledge Hub</strong> được tạo ra bởi một AI Engineer với niềm đam mê chia sẻ kiến thức. 
					Sau nhiều năm làm việc với AI/ML trong thực tế, tôi nhận ra rằng khoảng cách giữa lý thuyết và thực hành 
					vẫn còn rất lớn, đặc biệt với những người mới bắt đầu.
				</p>
				<p>
					Blog này sinh ra với mục đích thu hẹp khoảng cách đó - cung cấp kiến thức có hệ thống, 
					từ những khái niệm cơ bản nhất cho đến các kỹ thuật tiên tiến nhất, tất cả đều được 
					viết bằng ngôn ngữ dễ hiểu và kèm theo ví dụ thực tế.
				</p>
			</div>

			<div class="about-section">
				<h2>Nội dung blog bao gồm</h2>
				<div class="topics-grid">
					<div class="topic-card">
						<h3>👁️ Computer Vision</h3>
						<p>Object Detection, Face Recognition, Pose Estimation, Image Segmentation, và các ứng dụng CV</p>
					</div>
					<div class="topic-card">
						<h3>🤖 LLM & Agents</h3>
						<p>Large Language Models, Prompt Engineering, RAG, AI Agents, LangChain, LangGraph</p>
					</div>
					<div class="topic-card">
						<h3>⚙️ MLOps</h3>
						<p>Model Deployment, Monitoring, CI/CD cho ML, Model Optimization, Production Best Practices</p>
					</div>
					<div class="topic-card">
						<h3>🔧 LLMOps</h3>
						<p>LLM Deployment, Evaluation, Fine-tuning, Serving, Cost Optimization cho LLM applications</p>
					</div>
					<div class="topic-card">
						<h3>🧠 Deep Learning</h3>
						<p>Neural Networks, CNN, RNN, Transformers, Training Techniques, Model Architecture Design</p>
					</div>
					<div class="topic-card">
						<h3>🚀 Production AI</h3>
						<p>Edge Deployment, Model Serving, API Design, Scalability, Performance Optimization</p>
					</div>
				</div>
			</div>

			<div class="about-section">
				<h2>Blog này dành cho ai?</h2>
				<ul class="audience-list">
					<li><strong>Sinh viên IT</strong> đang muốn tìm hiểu về AI và Machine Learning</li>
					<li><strong>Người định hướng làm AI Engineer</strong> cần lộ trình học tập rõ ràng</li>
					<li><strong>Fresher & Junior AI Engineer</strong> muốn nâng cao kỹ năng thực chiến</li>
					<li><strong>Người từ ngành khác</strong> muốn chuyển sang làm AI</li>
				
				</ul>
			</div>

			<div class="about-section">
				<h2>Phương pháp tiếp cận</h2>
				<p>
					Mỗi chủ đề được viết theo phương pháp <strong>từ cơ bản đến chuyên sâu</strong>:
				</p>
				<ul style="line-height: 2; padding-left: 2rem; margin-top: 1rem;">
					<li><strong>Khái niệm cơ bản</strong> — Giải thích rõ ràng, dễ hiểu cho người mới</li>
					<li><strong>Lý thuyết nền tảng</strong> — Hiểu sâu về cách thức hoạt động</li>
					<li><strong>Thực hành</strong> — Code examples, hands-on tutorials</li>
					<li><strong>Best practices</strong> — Kinh nghiệm từ production</li>
					<li><strong>Advanced topics</strong> — Kỹ thuật chuyên sâu cho những ai muốn đi xa hơn</li>
				</ul>
			</div>

			<div class="about-section">
				<h2>Ngôn ngữ</h2>
				<p>
					Nội dung được viết song ngữ <strong>Tiếng Việt</strong> và <strong>Tiếng Anh</strong>, 
					giúp bạn dễ dàng tiếp cận kiến thức bằng ngôn ngữ mà bạn cảm thấy thoải mái nhất.
				</p>
			</div>

			<div class="cta-box">
				<h2 style="margin-top: 0;">Bắt đầu học ngay</h2>
				<p style="color: var(--gray); margin-bottom: 0;">
					Khám phá các bài viết về AI, từ cơ bản đến chuyên sâu
				</p>
				<a href="/blog">
					Xem tất cả bài viết →
				</a>
			</div>

			<div class="about-section" style="margin-top: 3rem; text-align: center;">
				<h2>Liên hệ</h2>
				<p>
					Có câu hỏi, góp ý, hoặc muốn thảo luận về AI?<br/>
					Hãy liên hệ qua email: <a href={`mailto:${SITE_EMAIL}`} style="color: var(--accent); font-weight: bold;">{SITE_EMAIL}</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
