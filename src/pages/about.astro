---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_EMAIL } from '../consts';
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Về Blog - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-container {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			.hero-section {
				text-align: center;
				margin-bottom: 3rem;
				padding: 2rem;
				background: linear-gradient(135deg, rgba(var(--accent-light), 0.1) 0%, rgba(var(--accent), 0.05) 100%);
				border-radius: 12px;
			}
			.hero-icon {
				font-size: 4rem;
				margin-bottom: 1rem;
			}
			.about-section {
				margin-bottom: 3rem;
				line-height: 1.8;
			}
			.about-section h2 {
				color: var(--accent);
				margin-bottom: 1rem;
				font-size: 1.8rem;
			}
			.about-section p {
				margin-bottom: 1rem;
				color: var(--gray-dark);
			}
			.topics-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 1.5rem;
				margin-top: 1.5rem;
			}
			.topic-card {
				background: var(--bg-secondary, #f5f5f5);
				padding: 1.5rem;
				border-radius: 8px;
				border-left: 4px solid var(--accent);
			}
			.topic-card h3 {
				color: var(--accent);
				margin-bottom: 0.8rem;
				font-size: 1.2rem;
			}
			.topic-card p {
				font-size: 0.95rem;
				color: var(--gray);
				margin: 0;
			}
			.topic-card .level-badge {
				display: inline-block;
				font-size: 0.75rem;
				background: rgba(var(--accent), 0.12);
				color: var(--accent);
				padding: 0.15rem 0.6rem;
				border-radius: 99px;
				margin-bottom: 0.6rem;
				font-weight: 600;
			}
			.audience-list {
				list-style: none;
				padding: 0;
				margin-top: 1rem;
			}
			.audience-list li {
				padding: 0.8rem 0;
				border-bottom: 1px solid rgba(var(--accent), 0.1);
			}
			.audience-list li:last-child {
				border-bottom: none;
			}
			.audience-list li:before {
				content: "✓ ";
				color: var(--accent);
				font-weight: bold;
				margin-right: 0.5rem;
			}
			.bilingual-box {
				background: var(--bg-secondary, #f5f5f5);
				border-left: 4px solid var(--accent);
				border-radius: 8px;
				padding: 1.5rem 2rem;
				margin-top: 1.5rem;
				line-height: 1.8;
			}
			.bilingual-box p {
				margin-bottom: 0.8rem;
				color: var(--gray-dark);
			}
			.bilingual-box p:last-child {
				margin-bottom: 0;
			}
			.cta-box {
				background: linear-gradient(135deg, rgba(var(--accent), 0.1) 0%, rgba(var(--accent-light), 0.05) 100%);
				padding: 2rem;
				border-radius: 12px;
				text-align: center;
				margin-top: 2rem;
			}
			.cta-box a {
				display: inline-block;
				background: var(--accent);
				color: white;
				padding: 0.8rem 2rem;
				border-radius: 6px;
				text-decoration: none;
				font-weight: bold;
				margin-top: 1rem;
				transition: transform 0.2s;
			}
			.cta-box a:hover {
				transform: translateY(-2px);
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="about-container">

			<!-- ✅ Hero: Nhất quán thương hiệu "Mèo Máy", nêu rõ điểm khác biệt song ngữ -->
			<div class="hero-section">
				<div class="hero-icon">🐱</div>
				<h1>Tớ là Mèo Máy</h1>
				<p style="font-size: 1.2rem; color: var(--gray); margin-top: 1rem;">
					Blog AI song ngữ — học kiến thức, luyện tiếng Anh chuyên ngành cùng một lúc.
				</p>
			</div>

			<!-- ✅ Giọng văn "Tớ" nhất quán với trang chủ -->
			<div class="about-section">
				<h2>Tại sao có blog này?</h2>
				<p>
					Tớ là một AI Engineer, và tớ vẫn nhớ rõ cảm giác mới bắt đầu học AI — không biết bắt đầu
					từ đâu, đọc đâu cũng thấy overwhelming, học xong lý thuyết nhưng không biết áp dụng vào thực tế ra sao.
				</p>
				<p>
					Blog này tớ viết theo cách mà tớ ước gì đã có người giải thích cho mình hồi đó: có hệ thống,
					dễ hiểu, gắn với thực tế, và không bỏ qua phần nền tảng quan trọng chỉ để trông "advanced" hơn.
				</p>
			</div>

			<!-- ✅ Thêm badge "từ cơ bản" để trấn an người mới, tránh cảm giác overwhelming -->
			<div class="about-section">
				<h2>Nội dung blog bao gồm</h2>
				<p>Mỗi chủ đề được xây dựng từ nền tảng đến production-ready — kiến thức bạn học ở đây là kiến thức bạn sẽ dùng thực sự khi đi làm.</p>
				<div class="topics-grid">
					<div class="topic-card">
						<div class="level-badge">Cơ bản → Production-ready</div>
						<h3>🤖 LLM & AI Agents</h3>
						<p>Large Language Models, Prompt Engineering, RAG, AI Agents, LangChain, LangGraph — bộ kỹ năng đang được yêu cầu nhiều nhất trong tuyển dụng AI hiện nay.</p>
					</div>
					<div class="topic-card">
						<div class="level-badge">Cơ bản → Production-ready</div>
						<h3>⚙️ MLOps & LLMOps</h3>
						<p>Model Deployment, Monitoring, CI/CD cho ML, Fine-tuning, Serving và tối ưu chi phí — kỹ năng giúp bạn đưa mô hình ra production thực sự.</p>
					</div>
					<div class="topic-card">
						<div class="level-badge">Cơ bản → Production-ready</div>
						<h3>🚀 Production AI</h3>
						<p>Edge Deployment, API Design, Scalability, Performance Optimization — những gì thực sự xảy ra khi AI chạy trong môi trường production.</p>
					</div>
					<div class="topic-card">
						<div class="level-badge">Cơ bản → Production-ready</div>
						<h3>🗺️ Lộ trình & Định hướng</h3>
						<p>Lộ trình và bộ kỹ năng thực chiến của một AI Engineer — từ nền tảng đến những gì thực sự được yêu cầu trong môi trường làm việc thực tế.</p>
					</div>
				</div>
			</div>

			<div class="about-section">
				<h2>Blog này dành cho ai?</h2>
				<ul class="audience-list">
					<li><strong>Sinh viên IT</strong> đang muốn tìm hiểu về AI và Machine Learning</li>
					<li><strong>Người định hướng làm AI Engineer</strong> cần lộ trình học tập rõ ràng</li>
					<li><strong>Fresher & Junior AI Engineer</strong> muốn nâng cao kỹ năng thực chiến</li>
					<li><strong>Người từ ngành khác</strong> muốn chuyển sang làm AI</li>
				</ul>
			</div>

			<div class="about-section">
				<h2>Phương pháp tiếp cận</h2>
				<p>
					Mỗi chủ đề được xây dựng theo hướng <strong>từ cơ bản đến chuyên sâu</strong> — bắt đầu bằng
					việc giải thích rõ khái niệm nền tảng, sau đó đi sâu vào lý thuyết, thực hành với code examples,
					rồi đến best practices từ production và các kỹ thuật nâng cao cho ai muốn đi xa hơn.
				</p>
				<p>
					Tớ không bỏ qua phần cơ bản để nhảy thẳng vào advanced — vì kinh nghiệm cho thấy đó thường
					là lý do khiến người học bị mắc kẹt sau này.
				</p>
			</div>

			<!-- ✅ Nâng cấp phần song ngữ thành điểm bán hàng rõ ràng -->
			<div class="about-section">
				<h2>Blog song ngữ — Tiếng Việt & Tiếng Anh</h2>
				<div class="bilingual-box">
					<p>
						Mỗi chủ đề lớn đều có <strong>bản tiếng Việt</strong> và <strong>bản tiếng Anh</strong>.
						Thuật ngữ chuyên ngành được giữ nguyên tiếng Anh trong cả hai bản — vì trong ngành AI,
						khả năng đọc tài liệu gốc tiếng Anh là kỹ năng không thể thiếu.
					</p>
					<p>
						Đọc song song hai bản là một cách tự nhiên để xây dựng vốn từ chuyên ngành mà không
						cần học riêng — bạn hiểu nội dung qua tiếng Việt, rồi đọc lại bản tiếng Anh để làm
						quen với cách diễn đạt kỹ thuật chuẩn mà bạn sẽ gặp trong tài liệu, paper, hay công việc thực tế.
					</p>
				</div>
			</div>

			<div class="cta-box">
				<h2 style="margin-top: 0;">Bắt đầu học ngay</h2>
				<p style="color: var(--gray); margin-bottom: 0;">
					Khám phá các bài viết về AI — từ lộ trình định hướng đến hướng dẫn thực hành chuyên sâu
				</p>
				<a href="/blog">
					Xem tất cả bài viết →
				</a>
			</div>

			<div class="about-section" style="margin-top: 3rem; text-align: center;">
				<h2>Liên hệ</h2>
				<p>
					Có câu hỏi, góp ý, hoặc muốn thảo luận về AI?<br/>
					Hãy liên hệ qua email: <a href={`mailto:${SITE_EMAIL}`} style="color: var(--accent); font-weight: bold;">{SITE_EMAIL}</a>
				</p>
			</div>

		</main>
		<Footer />
	</body>
</html>